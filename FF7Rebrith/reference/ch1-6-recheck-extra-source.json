  {
    "id": "$CF_Unit_ATK_01",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "警備兵"
    },
    "English": {
      "Text": "Security Officer"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_01_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "マシンガンで離れた位置から攻撃します。敵アタッカーの中で最も弱いユニットです。"
    },
    "English": {
      "Text": "A weak vanguard unit that attacks from a distance."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_04",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "特殊空中兵"
    },
    "English": {
      "Text": "Elite Helitrooper"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_04_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "前方を貫通する火炎放射で攻撃します。敵アタッカーの中でそこそこの強さを持つユニットです。"
    },
    "English": {
      "Text": "A powerful airborne vanguard unit that douses enemies in flame."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_06",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "カッターマシン"
    },
    "English": {
      "Text": "Cutter"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_06_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "周囲を回転のこぎりで攻撃します。敵アタッカーの中で最も強力なユニットです。"
    },
    "English": {
      "Text": "A very powerful vanguard unit that strikes enemies in its immediate vicinity with its saw blades."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "アタッカー"
    },
    "English": {
      "Text": "Vanguard"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_CondorOpp",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ヴィランアタッカー"
    },
    "English": {
      "Text": "Villainous Vanguard"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_CondorOpp_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "元コンドル軍エース、近接攻撃で近い位置の敵を攻撃します。移動が速く攻撃間隔の短い歩兵ユニットです。"
    },
    "English": {
      "Text": "An elite close-combat unit capable of striking and moving quickly."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_ATK_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近接攻撃で近い位置の敵を攻撃します。移動が速く攻撃間隔も短い、オーソドックスなユニットです。"
    },
    "English": {
      "Text": "A standard close-combat unit capable of striking and moving quickly."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_BASE_01",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "メインベース"
    },
    "English": {
      "Text": "Headquarters"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_BASE_01_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近づいた敵ユニットに対して、火の玉を吐いて範囲攻撃します。メインベースが破壊されると敗戦になります。"
    },
    "English": {
      "Text": "Spews fireballs over a wide area when enemies approach. You will lose the match if this unit falls."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_BASE_02",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "サブベース"
    },
    "English": {
      "Text": "Outpost"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_BASE_02_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近づいた敵ユニットに対して、羽を飛ばして単体攻撃をします。サブベースが破壊されても勝敗には影響しません。"
    },
    "English": {
      "Text": "Flings piercing pinions at approaching enemies. Losing this unit will not affect your chances at victory."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Ballista_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "バリスタ"
    },
    "English": {
      "Text": "Ballista"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Ballista_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "前方にユニットを貫通する直線的な攻撃をします。強力な反面、攻撃範囲が限られ、移動はできない固定配置ユニットです。"
    },
    "English": {
      "Text": "A powerful static melee unit that strikes enemies directly in front of it with piercing blows."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Barbarian_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "バーバリアン"
    },
    "English": {
      "Text": "Warlord"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Barbarian_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "強力なステータスを有する司令官ボスユニットです。腕を振り回して攻撃するほか、離れた敵に対しては岩を投げてきます。撃破すると勝利になります。"
    },
    "English": {
      "Text": "An immensely powerful boss unit that is capable of both melee and ranged attacks. Destroy this unit to win the match."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Barbarian_Condor_help2",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "とても高い耐久力を誇る、ロール相性を持たないジェネラルユニットです。移動速度はとても遅いため、戦力を集めて撃破することが重要です。"
    },
    "English": {
      "Text": "An extremely powerful unit with a large amount of HP and no role affiliation. Despite its strength, it is incredibly slow, which allows hostile units to gang up on it."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Beast_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ビースト"
    },
    "English": {
      "Text": "Archfiend"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Beast_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ユニットを無視してベース拠点を狙う、ロール相性を持たないジェネラルユニットです。移動速度と攻撃力に優れる一方で、ＨＰは低いです。"
    },
    "English": {
      "Text": "A unit with no role affiliation, whose only goal is to strike at a stronghold. While it is both incredibly fast and powerful, it has a small amount of HP."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Catapult_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "投石器"
    },
    "English": {
      "Text": "Trebuchet"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_Catapult_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "前方の離れた位置に広範囲の攻撃をします。強力な反面、攻撃範囲が限られ、移動はできない固定配置ユニットです。"
    },
    "English": {
      "Text": "A powerful long-ranged static unit capable of striking a wide, but fixed, area."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_01",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "鎮圧兵"
    },
    "English": {
      "Text": "Riot Trooper"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_01_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "シールドバッシュで前方を攻撃します。移動は遅いが、高いＨＰで耐久力があります。敵ディフェンダーの中で最も弱いユニットです。"
    },
    "English": {
      "Text": "A weak defense unit that uses Shield Bash to attack enemies in front of it. While slow, it has a large amount of HP."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_03",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "グレネードソーサー"
    },
    "English": {
      "Text": "Blast-Ray"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_03_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "爆発するグレネードで離れた場所から攻撃します。敵ディフェンダーの中でそこそこの強さを持つユニットです。"
    },
    "English": {
      "Text": "A powerful defense unit that fires explosive grenades from range."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_09",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "モススラッシャー"
    },
    "English": {
      "Text": "M.O.T.H. Unit"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_09_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "カッターストームで全方位を攻撃します。敵ディフェンダーの中で最も強力なユニットです。"
    },
    "English": {
      "Text": "A very powerful defense unit that attacks in all directions with spinning blades."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ディフェンダー"
    },
    "English": {
      "Text": "Enforcer"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_CondorOpp",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ヴィランディフェンダー"
    },
    "English": {
      "Text": "Evil Enforcer"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_CondorOpp_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "元コンドル軍エース、近接攻撃で近くの敵を攻撃します。ＨＰが高く戦闘の最前線を支える防衛ユニットです。"
    },
    "English": {
      "Text": "An elite close-combat unit with a large amount of HP designed to defend the front lines."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DEF_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近接攻撃で近くの敵を攻撃します。ＨＰが高く堅い守りで前線を支える、オーソドックスなユニットです。"
    },
    "English": {
      "Text": "A standard close-combat unit with a large amount of HP designed to defend the front lines."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "魔王"
    },
    "English": {
      "Text": "Warlock"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor_Ability01",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "アタッカー変身！"
    },
    "English": {
      "Text": "Vanguard Assault!"
    },
    "mode": "English_name"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor_Ability02",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "シューター変身！"
    },
    "English": {
      "Text": "Ranged Strike!"
    },
    "mode": "English_name"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor_Ability03",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ディフェンダー変身！"
    },
    "English": {
      "Text": "Defensive Maneuvers!"
    },
    "mode": "English_name"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor_Ability04",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "ちょっとストップ！"
    },
    "English": {
      "Text": "Hold It!"
    },
    "mode": "English_name"
  },
  {
    "id": "$CF_Unit_DevilGilgamesh_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "神羅軍に寝返った隊長さんが変身した魔王ボスユニットです。３つの武器を持ち変えてどのユニットにも有利に戦いを挑んできます。撃破すると勝利になります。"
    },
    "English": {
      "Text": "The erstwhile captain who defected to Shinra. A boss unit capable of altering his role at a moment's notice. Defeat this unit to win the match."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteATK_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "エースアタッカー"
    },
    "English": {
      "Text": "Elite Vanguard"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteATK_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近接攻撃で近い位置の敵を攻撃します。移動が速く攻撃間隔も短い、エースユニットです。性能は高いですが、配置コストも上がります。"
    },
    "English": {
      "Text": "A close-combat unit capable of striking and moving quickly. More expensive than a standard unit, but also more powerful."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteDEF_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "エースディフェンダー"
    },
    "English": {
      "Text": "Elite Enforcer"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteDEF_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "近接攻撃で近くの敵を攻撃します。ＨＰが高く堅い守りで前線を支える、エースユニットです。性能は高いですが、配置コストも上がります。"
    },
    "English": {
      "Text": "A close-combat unit with a large amount of HP designed to defend the front lines. More expensive than a standard unit, but also more powerful."
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteSHT_Condor",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "エースシューター"
    },
    "English": {
      "Text": "Elite Ranger"
    },
    "mode": "existing"
  },
  {
    "id": "$CF_Unit_EliteSHT_Condor_help",
    "asset": "End/Content/Text/JP/Resident_TxtRes.uasset",
    "Japanese": {
      "Text": "遠隔攻撃で離れた位置の敵を攻撃します。攻撃の射程が長く後方での支援に向いた、エースユニットです。性能は高いですが、配置コストも上がります。"
